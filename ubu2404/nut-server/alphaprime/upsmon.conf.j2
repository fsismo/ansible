# master del UPS local (USB). Ver ubu2404/nut-server/alphaprime.yml
MONITOR {{ nut_ups_name }}@localhost 1 admin {{ nut_admin_password }} master
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
POWERDOWNFLAG /etc/killpower
RBWARNTIME 43200
NOCOMMWARNTIME 300
FINALDELAY 5
