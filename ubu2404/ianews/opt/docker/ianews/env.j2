# Generado por ansible (ubu2404/ianews-{scraper,processor}/ianews-*.yml, vars
# compartidas en ubu2404/ianews/vars.yml) — no editar a mano, se pisa en el
# próximo deploy de cualquiera de las dos piezas. Valores de producción,
# ajustables en ubu2404/ianews/vars.yml. Tiene dos secretos (password de
# Postgres, API key de Pexels) — permisos 0640, mismo criterio que el .env
# de ollama.

# ── HTTP ───────────────────────────────────────────────────────────────
# UA de navegador, no de bot: varios medios bloquean/degradan clientes
# no-browser (mismo criterio que el .env de desarrollo del repo ianews, no
# el .env.example). Ver wiki/Decisiones.md de ese repo.
IANEWS_HTTP_USER_AGENT="{{ ianews_http_user_agent }}"
IANEWS_HTTP_REQUEST_TIMEOUT={{ ianews_http_request_timeout }}
IANEWS_HTTP_DELAY_SECONDS={{ ianews_http_delay_seconds }}

# ── Scraper ────────────────────────────────────────────────────────────
IANEWS_SCRAPER_MAX_ARTICLES_PER_FEED={{ ianews_scraper_max_articles_per_feed }}
IANEWS_SCRAPER_OUTPUT_DIR={{ ianews_scraper_output_dir }}
IANEWS_SCRAPER_RESPECT_ROBOTS={{ ianews_scraper_respect_robots }}

# ── Processor ──────────────────────────────────────────────────────────
# Ollama corre en otro host (alphaprime.sismonda.local), no en este compose:
# tiene que ser una URL de red, no un nombre de servicio Docker.
IANEWS_OLLAMA_BASE_URL="{{ ianews_ollama_base_url }}"
IANEWS_OLLAMA_MODEL="{{ ianews_ollama_model }}"
IANEWS_OLLAMA_REQUEST_TIMEOUT={{ ianews_ollama_request_timeout }}
# Mismo directorio que escribe el scraper — el processor lee y reescribe esos
# JSON in-place, no tiene salida propia.
IANEWS_PROCESSOR_DATA_DIR={{ ianews_processor_data_dir }}

# ── Postgres (cluster/redactar) ────────────────────────────────────────
# Ver ubu2404/ianews-postgres/ — mismo host (rbpi4004), otro compose project.
IANEWS_POSTGRES_DSN="{{ ianews_postgres_dsn }}"

# ── Imagen (paso 5) ────────────────────────────────────────────────────
# ComfyUI en alphaprime, iGPU Strix (no la discreta que usa Ollama).
IANEWS_PEXELS_API_KEY="{{ ianews_pexels_api_key }}"
IANEWS_COMFYUI_BASE_URL="{{ ianews_comfyui_base_url }}"
