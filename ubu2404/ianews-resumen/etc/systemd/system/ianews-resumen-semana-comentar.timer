[Unit]
Description=Timer para ianews resumen-semana-comentar (los domingos a las 11:40, después de que se publica el semanal)
# Sin Requires=: ver ianews-resumen-semana.timer.

[Timer]
OnCalendar=Sun *-*-* 11:40:00
# Con Persistent: si el host estaba apagado, comentar tarde sirve igual.
Persistent=true

[Install]
WantedBy=timers.target
