[Unit]
Description=Timer para ianews informe de URLs (cada 48h)
# Sin Requires=: arrancar el timer (en un deploy o al reiniciar) arrancaría
# también el servicio fuera de horario. Ver ianews-resumen.timer.

[Timer]
# Intervalo real (no calendario): 48h desde la última corrida, no un
# horario fijo de reloj. OnBootSec cubre el caso de un host recién
# reiniciado, sin esperar 48h para la primera corrida.
OnBootSec=15min
OnUnitActiveSec=48h
Persistent=true

[Install]
WantedBy=timers.target
