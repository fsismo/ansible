[Unit]
Description=ianews processor worker (ejecuta la cola de trabajos de a uno)
# Los timers (ianews-processor, ianews-cluster-redactar) solo encolan en la
# tabla `trabajos` de Postgres; este worker los toma de a uno, así dos pasos
# que usan alphaprime (Ollama/ComfyUI) nunca corren a la vez. Ver
# wiki/Decisiones.md § Cola de trabajos (2026-09-24) del repo ianews.
Requires=docker.service
After=docker.service network-online.target ianews-postgres.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ compose_dir }}
# Nombre fijo para poder pararlo con `docker stop` (el worker devuelve a la
# cola el trabajo que tenga en curso) y limpiar uno que haya quedado.
ExecStartPre=-/usr/bin/docker rm -f ianews-processor-worker
ExecStart=/usr/bin/docker compose -f compose.yml -f compose.override.yml run --rm --name ianews-processor-worker processor worker
ExecStop=/usr/bin/docker stop -t 30 ianews-processor-worker
TimeoutStopSec=60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
