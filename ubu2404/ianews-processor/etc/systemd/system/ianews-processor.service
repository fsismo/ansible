[Unit]
Description=ianews processor: encola la extraccion de entidades (la ejecuta ianews-processor-worker)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ compose_dir }}
# Solo encola (`run` = extracción de entidades) y termina en segundos: lo
# ejecuta ianews-processor-worker.service cuando le toque. Si ya hay uno
# pendiente no se duplica. Ver wiki/Decisiones.md § Cola de trabajos
# (2026-09-24) del repo ianews.
# Prioridad -1: si hay un paso de la cadena cluster→build esperando, va
# primero. Las entidades recién las usa el cluster de la cadena siguiente
# (2 h después), así que demorar el run hasta que termine la cadena no
# atrasa ninguna noticia; intercalarlo atrasaba la cadena ~10 min.
ExecStart=/usr/bin/docker compose -f compose.yml -f compose.override.yml run --rm processor encolar --prioridad -1 --origen ianews-processor.timer run
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
