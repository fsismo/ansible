[Unit]
Description=Timer para ianews processor (encola entidades cada hora, 20' despues del scraper)
# Sin Requires=: arrancar el timer (en un deploy o al reiniciar) arrancaría
# también el servicio fuera de horario. Ver ianews-resumen.timer.

[Timer]
Unit=ianews-processor.service
OnCalendar=*-*-* *:20:00
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
