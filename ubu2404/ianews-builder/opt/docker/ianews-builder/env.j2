# Generado por ansible (ubu2404/ianews-builder/ianews-builder.yml, vars
# compartidas en ubu2404/ianews/vars.yml y ubu2404/ianews-web/vars.yml) —
# no editar a mano. Sin secretos propios (la password de Postgres sí viaja
# acá, mismo criterio de permisos 0640 que el resto).
IANEWS_POSTGRES_DSN="{{ ianews_postgres_dsn }}"
IANEWS_SITE_URL="https://{{ ianews_web_domain }}"
# Rutas DENTRO del contenedor — ver compose.yml, son las que ese compose
# monta como /output y /imagenes.
IANEWS_BUILDER_OUTPUT_DIR=/output
IANEWS_IMAGENES_DIR=/imagenes
# AdSense (unidades manuales) — ver ubu2404/ianews-web/vars.yml y
# wiki/Decisiones.md § Integración de Google AdSense del repo ianews.
# ianews_web_adsense_enabled en false: el script del <head> sigue
# presente, pero el Builder no renderiza ningún bloque de anuncio.
IANEWS_ADSENSE_ENABLED="{{ ianews_web_adsense_enabled }}"
IANEWS_ADSENSE_CLIENT="ca-{{ ianews_web_adsense_publisher_id }}"
IANEWS_ADSENSE_INFEED_SLOT="{{ ianews_web_adsense_infeed_slot }}"
IANEWS_ADSENSE_INFEED_LAYOUT_KEY="{{ ianews_web_adsense_infeed_layout_key }}"
IANEWS_ADSENSE_TOP_SLOT="{{ ianews_web_adsense_top_slot }}"
IANEWS_ADSENSE_SIDEBAR_SLOT="{{ ianews_web_adsense_sidebar_slot }}"
IANEWS_ADSENSE_ARTICLE_SLOT="{{ ianews_web_adsense_article_slot }}"
