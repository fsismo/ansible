[Unit]
Description=ianews cluster+redactar+sesgo+imagen+wikidata+build: encola el primer paso (los ejecutan los workers)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ compose_dir }}
# Solo encola `cluster` y termina en segundos. La cadena la arma
# ianews-processor-worker: al terminar cada paso (ok o error — un fallo no
# frena al siguiente) encola el próximo, y el último (`build`) lo toma
# ianews-builder-worker. Ver processor/main.py::CADENA y wiki/Decisiones.md
# § Cola de trabajos (2026-09-24) del repo ianews.
ExecStart=/usr/bin/docker compose -f compose.yml -f compose.override.yml run --rm processor encolar --origen ianews-cluster-redactar.timer cluster --fusion-entidades
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
