[Unit]
Description=Timer para ianews cluster+redactar+sesgo+imagen+build (encola cada 2h)
# Sin Requires=: arrancar el timer (en un deploy o al reiniciar) arrancaría
# también el servicio fuera de horario. Ver ianews-resumen.timer.

[Timer]
# Desde la cola de trabajos (2026-09-24) el service solo encola y termina en
# segundos, así que esto es un intervalo de 2h entre encolados. Si la cadena
# anterior todavía no arrancó su `cluster`, no se duplica (un solo pendiente
# por acción). Ver wiki/Decisiones.md § La cadena corre cada 2 horas y
# § Cola de trabajos del repo ianews.
OnBootSec=20min
OnUnitActiveSec=2h
Persistent=true

[Install]
WantedBy=timers.target
