[Unit]
Description=Pi-Hole / WireGuard - Containers
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=0
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/docker/phwrgrd/
# El sync es opcional (prefijo "-"): el NAS tarda más que las Raspberry en levantar
# y el DNS no puede esperarlo. Pi-hole arranca con la config local y
# phwrgrd-sync.timer sincroniza cuando el NFS vuelve.
ExecStartPre=-/usr/bin/timeout 60 /opt/utils/pihole-sync-slave.sh
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
Restart=on-failure
RestartSec=30
[Install]
WantedBy=multi-user.target
