[Unit]
Description=Timer para ianews scraper (cada 60 min)
# Sin Requires= al service: con él, parar o cortar una corrida colgada
# (TimeoutStartSec) también apaga el timer y no vuelve a disparar.
# Unit= alcanza para asociarlos.

[Timer]
Unit=ianews-scraper.service
OnCalendar=hourly
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
