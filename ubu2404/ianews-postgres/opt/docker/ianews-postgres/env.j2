# Generado por ansible (ubu2404/ianews-postgres/ianews-postgres.yml, vars
# compartidas en ubu2404/ianews/vars.yml) — no editar a mano, se pisa en el
# próximo deploy. La password sale del lookup `password` de Ansible evaluado
# en el controller (no `openssl rand` en el host destino como ollama.yml):
# server y cliente comparten hoy el mismo host (rbpi4004), pero el valor
# tiene que seguir siendo válido si algún día quedan en hosts distintos —
# generarlo en el host destino lo dejaría atrapado en un solo .env. Ver
# ubu2404/ianews/vars.yml y wiki/Decisiones.md § Postgres para
# cluster/redactar del repo ianews.

POSTGRES_USER={{ ianews_postgres_user }}
POSTGRES_PASSWORD={{ ianews_postgres_password }}
POSTGRES_DB={{ ianews_postgres_db }}
